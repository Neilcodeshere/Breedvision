# Frontend public configuration.
#
# Only NEXT_PUBLIC_* values belong here — everything in this file is bundled
# into the browser and is readable by anyone. Never put a Supabase
# service-role key, database URL, or any API secret in this file.

# Base URL of the FastAPI backend (Phase 9).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Serve the app from the mock service layer instead of the real API.
# Leave as "true" until POST /predict exists. Set to "false" to go live.
# While true, every screen rendering mock-derived data shows a visible notice.
NEXT_PUBLIC_USE_MOCKS=true

# Supabase (optional; the app works fully on-device without it).
# Use the PUBLIC key only: the project's anon / publishable key. Everything
# NEXT_PUBLIC_* is bundled into the browser and readable by anyone.
#
# NEVER put the service-role or secret key here. It bypasses every row-level
# security rule and would give every visitor full access to all user data. The
# app refuses to start the client if it detects one, but treat that as a seatbelt,
# not permission.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
